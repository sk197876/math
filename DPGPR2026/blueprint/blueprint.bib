@Article{DePhilippis2018,
  author           = {De Philippis, Guido and De Rosa, Antonio and Ghiraldin, Francesco},
  journal          = {Comm. Pure Appl. Math.},
  title            = {Rectifiability of varifolds with locally bounded first variation with respect to anisotropic surface energies},
  year             = {2018},
  issn             = {0010-3640},
  month            = aug,
  number           = {6},
  pages            = {1123--1148},
  volume           = {71},
  abstract         = {We extend Allard's celebrated rectifiability theorem to the setting of varifolds with locally bounded first variation with respect to an anisotropic integrand. In particular, we identify a sufficient and necessary condition on the integrand to obtain the rectifiability of every d-dimensional varifold with locally bounded first variation and positive d-dimensional density. In codimension 1, this condition is shown to be equivalent to the strict convexity of the integrand with respect to the tangent plane.},
  archiveprefix    = {arXiv},
  creationdate     = {2025-07-09T09:38:17},
  doi              = {10.1002/cpa.21713},
  eprint           = {1609.01908},
  file             = {:Phili_/Philippis2018_Philippis.Rosa.ea_RectifiabilityOfVarifoldsWithLocallyBoun.pdf:PDF},
  fjournal         = {Communications on Pure and Applied Mathematics},
  issue            = {6},
  keywords         = {49Q15 (28A75)},
  modificationdate = {2025-07-09T09:38:17},
  mrclass          = {49Q15 (28A75)},
  mrnumber         = {3794529},
  mrreviewer       = {S\l awomir Kolasi\'{n}ski},
  page             = {1123-1148},
  publisher        = {Wiley},
  url              = {https://doi.org/10.1002/cpa.21713},
}


@Article{ArroyoRabasa2019,
  author           = {Adolfo Arroyo-Rabasa and Guido De Philippis and Jonas Hirsch and Filip Rindler},
  journal          = {Geometric and Functional Analysis},
  title            = {Dimensional estimates and rectifiability for measures satisfying linear {PDE} constraints},
  year             = {2019},
  issn             = {1016-443X,1420-8970},
  month            = apr,
  number           = {3},
  pages            = {639--658},
  volume           = {29},
  abstract         = {We establish the rectifiability of measures satisfying a linear PDE con-
straint. The obtained rectifiability dimensions are optimal for many usual PDE
operators, including all first-order systems and all second-order scalar operators. In
particular, our general theorem provides a new proof of the rectifiability results for
functions of bounded variations (BV) and functions of bounded deformation (BD).
For divergence-free tensors we obtain refinements and new proofs of several known
results on the rectifiability of varifolds and defect measures.},
  creationdate     = {2025-07-09T09:28:50},
  doi              = {10.1007/s00039-019-00497-1},
  file             = {:Arroy_/ArroyoRabasa2019_Arroyo-Rabasa.Philippis.ea_DimensionalEstimatesAndRectifiabilityFor (1).pdf:PDF:https\://link.springer.com/content/pdf/10.1007/s00039-019-00497-1.pdf;:Arroy_/ArroyoRabasa2019_Arroyo-Rabasa.Philippis.ea_DimensionalEstimatesAndRectifiabilityFor.pdf:PDF},
  fjournal         = {Geometric and Functional Analysis},
  issue            = {3},
  keywords         = {and phrases: Rectifiability, dimensional estimate, A-free measure, PDE constraint},
  modificationdate = {2025-07-09T09:28:50},
  mrclass          = {49Q15 (28A75)},
  mrnumber         = {3962875},
  mrreviewer       = {Davide\ Vittone},
  page             = {639-658},
  publisher        = {Springer Science and Business Media {LLC}},
  url              = {http://dx.doi.org/10.1007/s00039-019-00497-1},
}


